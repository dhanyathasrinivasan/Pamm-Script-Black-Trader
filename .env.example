# ==============================================================================
# PAMM TEST HUB CONFIGURATION
# Copy this file to '.env' and fill in your own values. '.env' is git-ignored.
# NEVER put real credentials in this example file.
# ==============================================================================

# Target platform (client portal / admin backoffice base URL)
PLATFORM_BASE_URL=https://your-platform.example.com

# PAMM manager (the master / pool owner) - the account that places the trades
ADMIN_USERNAME=your_manager_email@example.com
ADMIN_PASSWORD=your_manager_password
MANAGER_SHARE_PERCENT=20

# Back-office admin (creates members and sets paper balances)
BLACKADMIN_EMAIL=your_backoffice_admin@example.com
BLACKADMIN_PASSWORD=your_backoffice_password

# Investor accounts: <INVESTOR_PREFIX><1..N>@<INVESTOR_DOMAIN>, all sharing one password
INVESTOR_PREFIX=pamfollower
INVESTOR_DOMAIN=mailinator.com
INVESTOR_PASSWORD=your_investor_password
TEST_FOLLOWER_COUNT=100

# Defaults (paper = simulated money; anything else needs --i-understand-real-money)
DEFAULT_INSTANCE=paper
DEFAULT_SYMBOL=BINANCE:BTCUSDT
MAX_CONCURRENT_THREADS=25

# Dashboard (binds to localhost). To listen on another interface you MUST set a token.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=5001
DASHBOARD_TOKEN=
